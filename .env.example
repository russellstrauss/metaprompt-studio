# Local dev only. Get a key at https://aistudio.google.com
# The key is never included in the production build. Production gets the key from the host's config endpoint.
VITE_GEMINI_API_KEY=
# Adobe Firefly image generation (https://developer.adobe.com/firefly-services/docs/firefly-api/)
ADOBE_FIREFLY_CLIENT_ID="your-firefly-client-id"
ADOBE_FIREFLY_CLIENT_SECRET="your-firefly-client-secret"