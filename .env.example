# Local dev only. Get a key at https://aistudio.google.com
# The key is never included in the production build. Production gets the key from the host's config endpoint.
VITE_GEMINI_API_KEY=
# Azure OpenAI image generation
AZURE_OPENAI_ENDPOINT="https://<your-resource-name>.openai.azure.com"
AZURE_OPENAI_API_KEY="your-azure-openai-api-key"
AZURE_OPENAI_IMAGE_DEPLOYMENT="your-image-deployment-name"
AZURE_OPENAI_API_VERSION="2024-02-15-preview"